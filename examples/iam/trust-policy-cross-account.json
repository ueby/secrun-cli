{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowWorkloadRoleFromAccount999",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::999999999999:role/ecs-checkout-prod-task-role"
      },
      "Action": "sts:AssumeRole",
      "Condition": {
        "StringEquals": {
          "sts:ExternalId": "<external-id>"
        }
      }
    }
  ]
}
