{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SecrunReadSecrets",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": [
        "arn:aws:secretsmanager:us-east-1:999999999999:secret:secrun/shared/prod-??????",
        "arn:aws:secretsmanager:us-east-1:999999999999:secret:secrun/checkout-api/prod-??????"
      ]
    },
    {
      "Sid": "SecrunDecryptWithCMK",
      "Effect": "Allow",
      "Action": "kms:Decrypt",
      "Resource": "arn:aws:kms:us-east-1:999999999999:key/<key-id>",
      "Condition": {
        "StringEquals": {
          "kms:ViaService": "secretsmanager.us-east-1.amazonaws.com"
        },
        "StringLike": {
          "kms:EncryptionContext:SecretARN": [
            "arn:aws:secretsmanager:us-east-1:999999999999:secret:secrun/*"
          ]
        }
      }
    }
  ]
}
